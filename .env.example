NODE_ENV=production
PORT=10000

# Core
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CLIENT_URL=https://sharx.in
PUBLIC_BASE_URL=https://sharx-backend.onrender.com
ALLOWED_ORIGINS=https://sharx.in

# WebAuthn / Passkeys
PASSKEY_RP_ID=sharx.in
PASSKEY_ORIGIN=https://sharx.in

# Email / OAuth
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://sharx-backend.onrender.com/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=consumers
MICROSOFT_CALLBACK_URL=https://sharx-backend.onrender.com/auth/microsoft/callback

# Real RazorpayX payouts. Keep FALSE until API Payouts access, webhook and
# live/test credentials have been verified.
RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Puppeteer on Render
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
