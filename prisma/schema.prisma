generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RewardSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  REVOKED
}

enum RewardLedgerType {
  TIME_REWARD
  REFERRAL_REWARD
  ADJUSTMENT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

model User {
  id          Int     @id @default(autoincrement())
  name        String
  email       String  @unique
  password    String?
  googleId    String? @unique
  avatar      String?
  score       Int     @default(0)
  tokenVersion Int    @default(0)
  microsoftId String? @unique

  passkeyCredentialId String? @unique
  passkeyPublicKey    Bytes?
  passkeyCounter      Int?

  currentChallenge          String?
  currentChallengeExpiresAt DateTime?

  matches Match[]

  rewardWallet     RewardWallet?
  rewardSessions   RewardSession[]
  rewardLedger     RewardLedger[]
  rewardMilestones RewardMilestone[]
  referralsMade    Referral[]        @relation("Referrer")
  referralReceived Referral?         @relation("Referred")
  withdrawals      Withdrawal[]
  passwordResetCodes PasswordResetCode[]
  authExchangeCodes AuthExchangeCode[]
}

model Match {
  id        Int      @id @default(autoincrement())
  result    String
  score     Int
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model RewardWallet {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  balancePaise           BigInt   @default(0)
  lifetimeEarnedPaise    BigInt   @default(0)
  lifetimeWithdrawnPaise BigInt   @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger      RewardLedger[]
  withdrawals Withdrawal[]
}

model RewardLedger {
  id                Int              @id @default(autoincrement())
  walletId          Int
  userId            Int
  type              RewardLedgerType
  amountPaise       BigInt
  balanceAfterPaise BigInt
  referenceKey      String           @unique
  description       String
  metadata          Json?
  createdAt         DateTime         @default(now())

  wallet RewardWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
}

model RewardSession {
  id                 String              @id @default(cuid())
  userId             Int
  gameId             String
  status             RewardSessionStatus @default(ACTIVE)
  startedAt          DateTime            @default(now())
  lastHeartbeatAt    DateTime            @default(now())
  endedAt            DateTime?
  qualifiedSeconds   Int                 @default(0)
  rewardedMilestones Int                 @default(0)
  clientInstanceId   String
  ipHash             String?
  userAgentHash      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

model RewardMilestone {
  id               Int      @id @default(autoincrement())
  userId           Int
  sessionId        String
  milestoneSeconds Int
  rewardPaise      Int
  referenceKey     String   @unique
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId])
}

model Referral {
  id             Int       @id @default(autoincrement())
  referrerUserId Int
  referredUserId Int       @unique
  code           String    @unique
  qualifiedAt    DateTime?
  createdAt      DateTime  @default(now())

  referrer User @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
}

model Withdrawal {
  id          String           @id @default(cuid())
  walletId    Int
  userId      Int
  amountPaise BigInt
  method      String
  destination String
  status      WithdrawalStatus @default(PENDING)
  note        String?
  createdAt   DateTime         @default(now())
  processedAt DateTime?
  updatedAt   DateTime @updatedAt
  providerPayoutId     String? @unique
  providerFundAccountId String?
  providerReferenceId  String?
  idempotencyKey       String? @unique
  failureReason       String?

  wallet RewardWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}


model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    Int
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([codeHash])
}

model AuthExchangeCode {
  id        String   @id @default(cuid())
  userId    Int
  codeHash  String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model WebhookEvent {
  id          String   @id
  provider    String
  event       String
  payloadHash String
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
}
